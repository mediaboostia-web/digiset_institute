# ==============================================================================
# Digi-SET Institute — variables d'environnement
# Copier ce fichier en `.env.local` pour le développement local (jamais commité).
# En production, ces variables sont saisies dans le dashboard Vercel
# (Project Settings > Environment Variables) — voir CONFIGURATION.md.
# ==============================================================================

# --- Supabase -----------------------------------------------------------------
# Project Settings > API dans le dashboard Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète — ne JAMAIS exposer au client, ni préfixer par NEXT_PUBLIC_.
# Utilisée uniquement dans src/lib/supabase/admin.ts (upload Storage privé).
SUPABASE_SERVICE_ROLE_KEY=

# --- Email transactionnel (Resend) ---------------------------------------------
# https://resend.com — clé API du projet.
RESEND_API_KEY=
# Adresse interne qui reçoit une notification à chaque soumission de formulaire.
NOTIFICATION_EMAIL_TO=

# --- Carte de localisation ------------------------------------------------------
# URL d'intégration Google Maps (Accueil + Contact) — cf. CONFIGURATION.md.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# --- Site -------------------------------------------------------------------
# URL canonique du site (SEO, sitemap, liens dans les emails). En local :
# http://localhost:3000 — en production : https://digiset-gabon.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Anti-spam (optionnel, activable après lancement si besoin) ----------------
# reCAPTCHA v3 — cf. CONFIGURATION.md "Anti-spam avancé (optionnel)".
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
